Heartbeat
| where TimeGenerated > ago(2h)
| where Computer contains "vm-win2022"
| summarize
    LastHeartbeat=max(TimeGenerated)
    by Computer

SecurityEvent
| where TimeGenerated > ago(2h)
| summarize
    EventCount=count()
    by EventID, Activity
| order by EventCount desc


SecurityEvent
| where TimeGenerated > ago(2h)
| where EventID in (4624, 4625, 4688)
| project
    TimeGenerated,
    Computer,
    EventID,
    Activity,
    Account,
    IpAddress,
    Process
| order by TimeGenerated desc
